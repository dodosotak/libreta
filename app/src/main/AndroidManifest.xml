<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reminder for a shift that wasn't ended. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The driver sends the current position with a tap (no background tracking). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Automatic sending during a shift: a location service with a notification, started while the app is open. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sklad">

        <activity
            android:name=".StartActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" />

        <activity android:name=".DriverActivity" />

        <activity
            android:name=".DeliveriesActivity"
            android:parentActivityName=".DriverActivity" />

        <activity
            android:name=".LocationsActivity"
            android:label="Polohy vodičov" />

        <activity
            android:name=".DriversMapActivity"
            android:label="Mapa vodičov"
            android:parentActivityName=".LocationsActivity" />

        <activity
            android:name=".VehiclesActivity"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AccountantsActivity"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".LocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".ShiftReminder"
            android:exported="false" />

        <activity
            android:name=".ShiftsActivity"
            android:parentActivityName=".MainActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
