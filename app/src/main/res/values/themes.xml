<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Each screen has its own toolbar (R.layout.toolbar) placed below the status bar. -->
    <style name="Theme.Sklad" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/libreta_blue</item>
        <item name="colorPrimaryVariant">@color/libreta_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/libreta_amber</item>
        <item name="colorSecondaryVariant">@color/libreta_amber</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Libreta.Dialog</item>
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Libreta.Small</item>
        <item name="textAppearanceButton">@style/Libreta.ButtonText</item>
    </style>
</resources>
