<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceHeadline4" />

    <TextView
        android:id="@+id/since"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_margin="24dp"
        android:textSize="24sp"
        app:cornerRadius="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/deliveries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="-12dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:text="Zásielky"
        app:icon="@drawable/ic_package" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/locations"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="Polohy vodičov"
        app:icon="@drawable/ic_location" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/vacation"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="Požiadať o dovolenku / lekára"
        android:visibility="gone"
        app:icon="@drawable/ic_beach" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_shift"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="Doplniť zabudnutú smenu"
        android:visibility="gone"
        app:icon="@drawable/ic_today" />

    <include
        android:id="@+id/summary"
        layout="@layout/month_summary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
