<?xml version="1.0" encoding="utf-8"?>
<!-- Drivers' locations: the driver's own "send" button and status on top (hidden for the owner), the others below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <LinearLayout
        android:id="@+id/own"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Poslať moju polohu"
            android:textSize="18sp"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_location" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Posielať automaticky počas smeny (každých 5 min)" />

        <TextView
            android:id="@+id/own_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:textAppearance="?attr/textAppearanceBody2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stop"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Zmazať moju polohu"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Everyone's position on one map (DriversMapActivity); for the driver and the office. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/show_map"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:text="Zobraziť všetkých na mape"
        app:icon="@drawable/ic_map" />

    <include
        layout="@layout/fragment_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
