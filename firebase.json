{
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "web",
    "ignore": ["**/.*"],
    "headers": [
      {
        "source": "**/*.@(js|css|html|webmanifest)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": false }
  }
}
