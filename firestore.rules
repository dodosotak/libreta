rules_version = '2';

// Libreta: the owner sees and edits everything; the accountant sees everything read-only;
// a driver's phone (anonymous sign-in, linked with a join code) reads its own record, starts/ends its own shifts
// and can add a forgotten past shift (marked with enteredAt).
// A closed month (closures/{yyyy-MM}) can't be changed by anyone until the owner opens it again.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && exists(/databases/$(database)/documents/owners/$(request.auth.uid));
    }

    function isAccountant() {
      return signedIn() && exists(/databases/$(database)/documents/accountants/$(request.auth.uid));
    }

    function isOffice() {
      return isOwner() || isAccountant();
    }

    // "2026-10-19T06:00" or "2026-10-19" -> is the month 2026-10 still open?
    function isOpen(dateText) {
      let parts = dateText.split('-');
      return !exists(/databases/$(database)/documents/closures/$(parts[0] + '-' + parts[1]));
    }

    // The first email/password account that claims ownership becomes the owner; afterwards nobody else can.
    match /meta/setup {
      allow get: if signedIn();
      allow create: if signedIn()
        && existsAfter(/databases/$(database)/documents/owners/$(request.auth.uid));
    }

    match /owners/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'password'
        && !exists(/databases/$(database)/documents/meta/setup)
        && existsAfter(/databases/$(database)/documents/meta/setup);
    }

    match /accountants/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow read, write: if isOwner();
    }

    match /closures/{month} {
      allow read: if isOffice();
      allow write: if isOwner();
    }

    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Deliveries of a day (date "yyyy-MM-dd"), entered by the owner before the shift. All drivers see them:
    // a driver takes a free one (OPEN -> IN_PROGRESS, own driverId and name), marks it delivered (-> DONE)
    // or gives it back (-> OPEN). Only the owner edits or deletes them.
    match /deliveries/{deliveryId} {
      allow read: if signedIn();
      allow write: if isOwner();

      function linkedDriver(id) {
        let d = get(/databases/$(database)/documents/drivers/$(id)).data;
        return d.uid == request.auth.uid && d.active == true;
      }

      function changes(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      allow update: if signedIn() && resource.data.status == 'OPEN'
        && changes(['status', 'driverId', 'driverName', 'takenAt'])
        && request.resource.data.status == 'IN_PROGRESS'
        && request.resource.data.driverId is string
        && linkedDriver(request.resource.data.driverId)
        && request.resource.data.driverName == get(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)).data.name
        && request.resource.data.takenAt == request.time;
      allow update: if signedIn() && resource.data.status == 'IN_PROGRESS'
        && linkedDriver(resource.data.driverId)
        && changes(['status', 'doneAt'])
        && request.resource.data.status == 'DONE'
        && request.resource.data.doneAt == request.time;
      allow update: if signedIn() && resource.data.status == 'IN_PROGRESS'
        && linkedDriver(resource.data.driverId)
        && changes(['status', 'driverId', 'driverName', 'takenAt'])
        && request.resource.data.status == 'OPEN'
        && request.resource.data.driverId == null
        && request.resource.data.driverName == null
        && request.resource.data.takenAt == null;
    }

    // Which driver record this phone (anonymous uid) belongs to – written by the phone itself, so the rules can tell a
    // linked driver from any other anonymous sign-in without knowing the driver's id (used for the locations below).
    match /links/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['driverId'])
        && request.resource.data.driverId is string
        && get(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)).data.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // This phone is linked to an active driver (checked against the driver record, so a stale link doesn't count).
    function isActiveDriverPhone() {
      return signedIn()
        && exists(/databases/$(database)/documents/links/$(request.auth.uid))
        && linkedRecord().uid == request.auth.uid
        && linkedRecord().active == true;
    }

    function linkedRecord() {
      return get(/databases/$(database)/documents/drivers/$(
        get(/databases/$(database)/documents/links/$(request.auth.uid)).data.driverId)).data;
    }

    // The driver's last sent position (one per driver, sent by a tap – no tracking in the background).
    // Seen by the owner and the other active drivers, not by the accountant. The driver may delete it.
    match /locations/{driverId} {
      function ownPhone() {
        let d = get(/databases/$(database)/documents/drivers/$(driverId)).data;
        return signedIn() && d.uid == request.auth.uid && d.active == true;
      }

      allow read: if isOwner() || isActiveDriverPhone();
      allow create, update: if ownPhone()
        && request.resource.data.keys().hasOnly(['name', 'lat', 'lng', 'accuracy', 'at'])
        && request.resource.data.name == get(/databases/$(database)/documents/drivers/$(driverId)).data.name
        && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.accuracy is number && request.resource.data.accuracy >= 0
        && request.resource.data.at == request.time;
      allow delete: if isOwner()
        || (signedIn() && get(/databases/$(database)/documents/drivers/$(driverId)).data.uid == request.auth.uid);
    }

    // Phone list for calling from "Polohy vodičov": only name and number (the driver records hold pay, drivers can't
    // read those). contacts/owner is the boss's number; contacts/{driverId} is kept in sync by the owner's app and by the
    // driver's own phone when the number is saved. Seen by the owner and the active drivers, not by the accountant.
    match /contacts/{id} {
      allow read: if isOwner() || isActiveDriverPhone();
      allow write: if isOwner();
      allow create, update: if signedIn() && id != 'owner'
        && get(/databases/$(database)/documents/drivers/$(id)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/drivers/$(id)).data.active == true
        && request.resource.data.keys().hasOnly(['name', 'phone'])
        && request.resource.data.name == get(/databases/$(database)/documents/drivers/$(id)).data.name
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30;
      // The driver clears the number in the profile.
      allow delete: if signedIn() && id != 'owner'
        && get(/databases/$(database)/documents/drivers/$(id)).data.uid == request.auth.uid;
    }

    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if isOffice();
      allow write: if isOwner();
    }

    match /drivers/{driverId} {
      allow read: if isOffice();
      allow write: if isOwner();
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      // Linking a phone: the driver writes only its own uid into a record that is not linked to another phone.
      allow update: if signedIn()
        && (resource.data.uid == null || resource.data.uid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      // Linking with the join code: knowing the code proves the driver, so it may take the record over from another
      // (lost, reinstalled, signed-out) phone; that phone loses access.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'linkCode'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.linkCode == resource.data.joinCode;
      // Signing out: the linked phone releases its record so the same code works again (on this or another phone).
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        && request.resource.data.uid == null;
      // Driver's profile: only the phone number.
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone'])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30;

      function driver() {
        return get(/databases/$(database)/documents/drivers/$(driverId)).data;
      }

      function isDriver() {
        return signedIn() && driver().uid == request.auth.uid;
      }

      match /shifts/{shiftId} {
        allow read: if isOffice() || isDriver();
        allow create: if isOwner() && isOpen(request.resource.data.start);
        allow update: if isOwner() && isOpen(resource.data.start) && isOpen(request.resource.data.start);
        allow delete: if isOwner() && isOpen(resource.data.start);

        // A driver's shift id is its start ("2026-10-19T06:00"), so the same start can't be written twice; a driver may have
        // several shifts a day. Older app versions used the start date ("2026-10-19") – still allowed for a live start.
        function startIsId() {
          return request.resource.data.start is string
            && request.resource.data.start.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}')
            && request.resource.data.start == shiftId;
        }

        allow create: if isDriver() && driver().active == true
          && request.resource.data.keys().hasOnly(['start', 'end', 'breakMin', 'note', 'startLoggedAt', 'vehicle', 'kmStart'])
          && (startIsId() || (request.resource.data.start is string && request.resource.data.start.matches(shiftId + 'T[0-9]{2}:[0-9]{2}')))
          && isOpen(request.resource.data.start)
          && request.resource.data.end == null
          && request.resource.data.get('vehicle', '') is string
          && (request.resource.data.get('kmStart', null) == null || request.resource.data.kmStart is int)
          && request.resource.data.startLoggedAt == request.time;
        // A past shift the driver forgot to start, added afterwards with its end (not on a future day).
        // Overlaps with other shifts are checked by the app – rules can't query.
        allow create: if isDriver() && driver().active == true
          && request.resource.data.keys().hasOnly(['start', 'end', 'breakMin', 'note', 'vehicle', 'kmStart', 'kmEnd', 'enteredAt'])
          && startIsId()
          && isOpen(request.resource.data.start)
          && timestamp.date(int(shiftId[0:4]), int(shiftId[5:7]), int(shiftId[8:10])) <= request.time
          && request.resource.data.end is string
          && request.resource.data.end.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}')
          && request.resource.data.end > request.resource.data.start
          && request.resource.data.breakMin is int && request.resource.data.breakMin >= 0
          && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 200
          && request.resource.data.get('vehicle', '') is string
          && (request.resource.data.get('kmStart', null) == null || request.resource.data.kmStart is int)
          && (request.resource.data.get('kmEnd', null) == null || request.resource.data.kmEnd is int)
          && request.resource.data.enteredAt == request.time;
        allow update: if isDriver() && resource.data.end == null && isOpen(resource.data.start)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['end', 'breakMin', 'endLoggedAt', 'kmEnd'])
          && request.resource.data.end is string
          && request.resource.data.breakMin is int
          && (request.resource.data.get('kmEnd', null) == null || request.resource.data.kmEnd is int)
          && request.resource.data.endLoggedAt == request.time;
      }

      match /absences/{absenceId} {
        allow read: if isOffice() || isDriver();
        allow create: if isOwner() && isOpen(request.resource.data.from) && isOpen(request.resource.data.to);
        allow update: if isOwner() && isOpen(resource.data.from) && isOpen(resource.data.to)
          && isOpen(request.resource.data.from) && isOpen(request.resource.data.to);
        allow delete: if isOwner() && isOpen(resource.data.from) && isOpen(resource.data.to);

        // Request from the driver's phone – a vacation or a doctor's visit (own or accompanying a family member, optionally
        // a number of hours on one day): always waits for the owner, who approves or rejects it (update above).
        allow create: if isDriver() && driver().active == true
          && request.resource.data.keys().hasOnly(['type', 'from', 'to', 'note', 'status', 'requestedAt', 'hours'])
          && request.resource.data.type in ['VACATION', 'DOCTOR', 'DOCTOR_FAMILY']
          && (request.resource.data.get('hours', null) == null
            || (request.resource.data.type in ['DOCTOR', 'DOCTOR_FAMILY']
              && request.resource.data.hours is number
              && request.resource.data.hours > 0 && request.resource.data.hours <= 24
              && request.resource.data.from == request.resource.data.to))
          && request.resource.data.status == 'PENDING'
          && request.resource.data.from is string && request.resource.data.from.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.to is string && request.resource.data.to.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.from <= request.resource.data.to
          && isOpen(request.resource.data.from) && isOpen(request.resource.data.to)
          && request.resource.data.note is string && request.resource.data.note.size() <= 200
          && request.resource.data.requestedAt == request.time;
        // The driver withdraws a waiting request or clears away a rejected one; approved vacations stay.
        allow delete: if isDriver() && resource.data.get('status', 'APPROVED') in ['PENDING', 'REJECTED'];
      }
    }
  }
}
