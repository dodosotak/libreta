rules_version = '2';

// Libreta: the owner sees and edits everything; the accountant sees everything read-only;
// a driver's phone (anonymous sign-in, linked with a join code) reads its own record, starts/ends its own shifts
// and can add a forgotten past shift (marked with enteredAt).
// A closed month (closures/{yyyy-MM}) can't be changed by anyone until the owner opens it again.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && exists(/databases/$(database)/documents/owners/$(request.auth.uid));
    }

    function isAccountant() {
      return signedIn() && exists(/databases/$(database)/documents/accountants/$(request.auth.uid));
    }

    function isOffice() {
      return isOwner() || isAccountant();
    }

    // "2026-10-19T06:00" or "2026-10-19" -> is the month 2026-10 still open?
    function isOpen(dateText) {
      let parts = dateText.split('-');
      return !exists(/databases/$(database)/documents/closures/$(parts[0] + '-' + parts[1]));
    }

    // The first email/password account that claims ownership becomes the owner; afterwards nobody else can.
    match /meta/setup {
      allow get: if signedIn();
      allow create: if signedIn()
        && existsAfter(/databases/$(database)/documents/owners/$(request.auth.uid));
    }

    match /owners/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'password'
        && !exists(/databases/$(database)/documents/meta/setup)
        && existsAfter(/databases/$(database)/documents/meta/setup);
    }

    match /accountants/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow read, write: if isOwner();
    }

    match /closures/{month} {
      allow read: if isOffice();
      allow write: if isOwner();
    }

    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if isOffice();
      allow write: if isOwner();
    }

    match /drivers/{driverId} {
      allow read: if isOffice();
      allow write: if isOwner();
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      // Linking a phone: the driver writes only its own uid into a record that is not linked to another phone.
      allow update: if signedIn()
        && (resource.data.uid == null || resource.data.uid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      // Linking with the join code: knowing the code proves the driver, so it may take the record over from another
      // (lost, reinstalled, signed-out) phone; that phone loses access.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'linkCode'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.linkCode == resource.data.joinCode;
      // Signing out: the linked phone releases its record so the same code works again (on this or another phone).
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        && request.resource.data.uid == null;
      // Driver's profile: only the phone number.
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone'])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30;

      function driver() {
        return get(/databases/$(database)/documents/drivers/$(driverId)).data;
      }

      function isDriver() {
        return signedIn() && driver().uid == request.auth.uid;
      }

      match /shifts/{shiftId} {
        allow read: if isOffice() || isDriver();
        allow create: if isOwner() && isOpen(request.resource.data.start);
        allow update: if isOwner() && isOpen(resource.data.start) && isOpen(request.resource.data.start);
        allow delete: if isOwner() && isOpen(resource.data.start);

        // A driver's shift id is its start ("2026-10-19T06:00"), so the same start can't be written twice; a driver may have
        // several shifts a day. Older app versions used the start date ("2026-10-19") – still allowed for a live start.
        function startIsId() {
          return request.resource.data.start is string
            && request.resource.data.start.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}')
            && request.resource.data.start == shiftId;
        }

        allow create: if isDriver() && driver().active == true
          && request.resource.data.keys().hasOnly(['start', 'end', 'breakMin', 'note', 'startLoggedAt', 'vehicle', 'kmStart'])
          && (startIsId() || (request.resource.data.start is string && request.resource.data.start.matches(shiftId + 'T[0-9]{2}:[0-9]{2}')))
          && isOpen(request.resource.data.start)
          && request.resource.data.end == null
          && request.resource.data.get('vehicle', '') is string
          && (request.resource.data.get('kmStart', null) == null || request.resource.data.kmStart is int)
          && request.resource.data.startLoggedAt == request.time;
        // A past shift the driver forgot to start, added afterwards with its end (not on a future day).
        // Overlaps with other shifts are checked by the app – rules can't query.
        allow create: if isDriver() && driver().active == true
          && request.resource.data.keys().hasOnly(['start', 'end', 'breakMin', 'note', 'vehicle', 'kmStart', 'kmEnd', 'enteredAt'])
          && startIsId()
          && isOpen(request.resource.data.start)
          && timestamp.date(int(shiftId[0:4]), int(shiftId[5:7]), int(shiftId[8:10])) <= request.time
          && request.resource.data.end is string
          && request.resource.data.end.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}')
          && request.resource.data.end > request.resource.data.start
          && request.resource.data.breakMin is int && request.resource.data.breakMin >= 0
          && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 200
          && request.resource.data.get('vehicle', '') is string
          && (request.resource.data.get('kmStart', null) == null || request.resource.data.kmStart is int)
          && (request.resource.data.get('kmEnd', null) == null || request.resource.data.kmEnd is int)
          && request.resource.data.enteredAt == request.time;
        allow update: if isDriver() && resource.data.end == null && isOpen(resource.data.start)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['end', 'breakMin', 'endLoggedAt', 'kmEnd'])
          && request.resource.data.end is string
          && request.resource.data.breakMin is int
          && (request.resource.data.get('kmEnd', null) == null || request.resource.data.kmEnd is int)
          && request.resource.data.endLoggedAt == request.time;
      }

      match /absences/{absenceId} {
        allow read: if isOffice() || isDriver();
        allow create: if isOwner() && isOpen(request.resource.data.from) && isOpen(request.resource.data.to);
        allow update: if isOwner() && isOpen(resource.data.from) && isOpen(resource.data.to)
          && isOpen(request.resource.data.from) && isOpen(request.resource.data.to);
        allow delete: if isOwner() && isOpen(resource.data.from) && isOpen(resource.data.to);

        // Vacation request from the driver's phone: always waits for the owner, who approves or rejects it (update above).
        allow create: if isDriver() && driver().active == true
          && request.resource.data.keys().hasOnly(['type', 'from', 'to', 'note', 'status', 'requestedAt'])
          && request.resource.data.type == 'VACATION'
          && request.resource.data.status == 'PENDING'
          && request.resource.data.from is string && request.resource.data.from.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.to is string && request.resource.data.to.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.from <= request.resource.data.to
          && isOpen(request.resource.data.from) && isOpen(request.resource.data.to)
          && request.resource.data.note is string && request.resource.data.note.size() <= 200
          && request.resource.data.requestedAt == request.time;
        // The driver withdraws a waiting request or clears away a rejected one; approved vacations stay.
        allow delete: if isDriver() && resource.data.get('status', 'APPROVED') in ['PENDING', 'REJECTED'];
      }
    }
  }
}
